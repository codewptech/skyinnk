// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  auth0Id              String    @unique
  name                 String?
  givenName            String?
  familyName           String?
  middleName           String?
  nickname             String?
  preferredUsername    String?
  email                String?
  emailVerified        Boolean?
  phoneNumber          String?
  phoneNumberVerified  Boolean?
  picture              String?
  profile              String?
  website              String?
  gender               String?
  birthdate            String?
  zoneinfo             String?
  locale               String?
  addressFormatted     String?
  addressStreetAddress String?
  addressLocality      String?
  addressRegion        String?
  addressPostalCode    String?
  addressCountry       String?
  auth0UpdatedAt       DateTime? @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @db.Timestamptz(6)

  // Academic authoring permissions; existing User columns and identity unchanged.
  roles                UserRole[]
  courseAssignments    CourseEducator[]

  @@index([email])
}

// V1 academic foundation: authoring records only. Public release authority
// is a separate immutable, transactional publication slice. No automatic grants.

model Role {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                   String @unique
  name                  String
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  users                 UserRole[]
}

model AcademicCategory {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                   String @unique
  name                  String
  archivedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  courses               CourseCategory[]
}

model AcademicLevel {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                   String @unique
  name                  String
  archivedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  courses               CourseLevel[]
}

model Curriculum {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                   String @unique
  name                  String
  archivedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  courses               CourseCurriculum[]
}

model Subject {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                   String @unique
  name                  String
  archivedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  courses               CourseSubject[]
  topics                SubjectTopic[]
}

model Topic {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                   String @unique
  name                  String
  parentId              String? @db.Uuid
  archivedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  parent                Topic? @relation("TopicTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children              Topic[] @relation("TopicTree")
  subjects              SubjectTopic[]
  lessons               LessonTopic[]

  @@index([parentId])
}

model Course {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceKey             String @unique
  slug                  String @unique
  title                 String
  summary               String @default("")
  audience              String @default("")
  archivedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  categories            CourseCategory[]
  levels                CourseLevel[]
  curricula             CourseCurriculum[]
  subjects              CourseSubject[]
  modules               Module[]
  educators             CourseEducator[]
  resources             CourseResource[]
}

model MediaAsset {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider              String
  externalKey           String
  mimeType              String?
  sizeBytes             Int?
  sha256                String?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  videoLessons          Lesson[] @relation("LessonVideo")
  resources             LearningResource[]

  @@unique([provider, externalKey])
}

model LearningResource {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceKey             String @unique
  title                 String
  mediaAssetId          String @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  mediaAsset            MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  courses               CourseResource[]
  lessons               LessonResource[]

  @@index([mediaAssetId])
}

model Module {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId              String @db.Uuid
  sourceKey             String @unique
  title                 String
  position              Int
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  course                Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lessons               Lesson[]

  @@unique([id, courseId])
  @@unique([courseId, position])
}

model Lesson {
  id                    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId              String @db.Uuid
  moduleId              String @db.Uuid
  sourceKey             String @unique
  slug                  String
  title                 String
  position              Int
  kind                  String @default("TEXT")
  overview              String @default("")
  notesMarkdown         String @default("")
  videoAssetId          String? @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)

  module                Module @relation(fields: [moduleId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: Restrict)
  videoAsset            MediaAsset? @relation("LessonVideo", fields: [videoAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  topics                LessonTopic[]
  resources             LessonResource[]

  @@unique([courseId, slug])
  @@unique([moduleId, position])
  @@index([videoAssetId])
  @@index([moduleId, courseId])
}

model UserRole {
  userId                String @db.Uuid
  roleId                String @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  user                  User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role                  Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model CourseEducator {
  courseId              String @db.Uuid
  userId                String @db.Uuid
  permission            String
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  course                Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                  User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([courseId, userId])
  @@index([userId])
}

model CourseCategory {
  courseId              String @db.Uuid
  categoryId            String @db.Uuid
  isPrimary             Boolean @default(false)

  course                Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category              AcademicCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([courseId, categoryId])
  @@index([categoryId])
}

model CourseLevel {
  courseId              String @db.Uuid
  levelId               String @db.Uuid

  course                Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  level                 AcademicLevel @relation(fields: [levelId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([courseId, levelId])
  @@index([levelId])
}

model CourseCurriculum {
  courseId              String @db.Uuid
  curriculumId          String @db.Uuid

  course                Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  curriculum            Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([courseId, curriculumId])
  @@index([curriculumId])
}

model CourseSubject {
  courseId              String @db.Uuid
  subjectId             String @db.Uuid
  isPrimary             Boolean @default(false)

  course                Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subject               Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([courseId, subjectId])
  @@index([subjectId])
}

model SubjectTopic {
  subjectId             String @db.Uuid
  topicId               String @db.Uuid

  subject               Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  topic                 Topic @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([subjectId, topicId])
  @@index([topicId])
}

model LessonTopic {
  lessonId              String @db.Uuid
  topicId               String @db.Uuid

  lesson                Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  topic                 Topic @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([lessonId, topicId])
  @@index([topicId])
}

model CourseResource {
  courseId              String @db.Uuid
  resourceId            String @db.Uuid
  position              Int

  course                Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resource              LearningResource @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([courseId, resourceId])
  @@unique([courseId, position])
  @@index([resourceId])
}

model LessonResource {
  lessonId              String @db.Uuid
  resourceId            String @db.Uuid
  position              Int

  lesson                Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resource              LearningResource @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([lessonId, resourceId])
  @@unique([lessonId, position])
  @@index([resourceId])
}
