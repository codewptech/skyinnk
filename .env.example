# Database configuration

DATABASE_URL=YOUR_DATABASE_URL
DIRECT_URL=YOUR_DIRECT_URL

# Auth0 configuration

NUXT_AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
NUXT_AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
NUXT_AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET
NUXT_AUTH0_SESSION_SECRET=YOUR_AUTH0_SESSION_SECRET
NUXT_AUTH0_APP_BASE_URL=http://localhost:3000

NUXT_PUBLIC_AUTH0_SYNC_FRESHNESS_MS=300000
NUXT_AUTH0_SYNC_RATE_LIMIT_MAX_REQUESTS=10
NUXT_AUTH0_SYNC_RATE_LIMIT_WINDOW_MS=60000

# Google Tag Manager configuration

NUXT_PUBLIC_GTM_ID=YOUR_PUBLIC_GTM_ID
NUXT_PUBLIC_ANALYTICS_ENABLED=false
