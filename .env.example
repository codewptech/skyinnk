DATABASE_URL=YOUR_DATABASE_URL
DIRECT_URL=YOUR_DIRECT_URL

# Auth0 Regular Web Application (Auth0 Dashboard > Applications > Settings)
NUXT_AUTH0_DOMAIN=YOUR_AUTH0_APP_DOMAIN
NUXT_AUTH0_CLIENT_ID=YOUR_AUTH0_APP_CLIENT_ID
NUXT_AUTH0_CLIENT_SECRET=YOUR_AUTH0_APP_CLIENT_SECRET
# Generate locally with: openssl rand -hex 64
NUXT_AUTH0_SESSION_SECRET=YOUR_SESSION_SECRET
# Use the public HTTPS origin in production, not the internal container address.
NUXT_AUTH0_APP_BASE_URL=http://localhost:3000

# Browser synchronization freshness; milliseconds (default: 5 minutes).
NUXT_PUBLIC_AUTH0_SYNC_FRESHNESS_MS=300000

# Server-only sync rate limit per verified Auth0 subject, per Node process.
NUXT_AUTH0_SYNC_RATE_LIMIT_MAX_REQUESTS=10
NUXT_AUTH0_SYNC_RATE_LIMIT_WINDOW_MS=60000
