{
  "name": "skyinnk",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "test:browser": "node --test --test-isolation=none tests/browser.integration.ts",
    "test:http": "node --test --test-isolation=none tests/http.integration.ts",
    "test:db": "node --test --test-isolation=none tests/database.integration.ts",
    "test:security": "node --test --test-isolation=none tests/security.integration.ts",
    "test:oidc": "node --test --test-isolation=none tests/oidc.integration.ts",
    "test:containers": "node --test --test-isolation=none tests/containers.integration.ts",
    "test:all": "node tests/helpers/require-integration.ts && prisma generate && node tests/helpers/build-security.ts && npm test && npm run test:db && npm run test:http && npm run test:security && npm run test:oidc && npm run test:browser && npm run test:containers",
    "check:all": "prisma validate && prisma generate && npm run typecheck && npm run build",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@auth0/auth0-nuxt": "^1.3.0",
    "@prisma/client": "6.19.3",
    "nuxt": "4.6.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14"
  }
}
